@page "/"
@using ClaimsIntake.Core.Models

<PageTitle>Nahlásenie poistnej udalosti</PageTitle>

<div class="container py-4" style="max-width: 1100px;">
    <h1 class="mb-1">Nahlásenie poistnej udalosti</h1>
    <p class="text-muted mb-4">Nahraj hlásenie, faktúry a fotodokumentáciu (max 10 súborov, max 5 MB na súbor).</p>
    <p class="text-muted small">Agent: @(agentEnabled ? "zapnutý" : "vypnutý")</p>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <label class="form-label fw-semibold">Súbory</label>
            <InputFile OnChange="OnFilesSelected" accept="image/*,application/pdf" multiple class="form-control" />
            <div class="form-text">Povolené: JPG, PNG, PDF (max 5 MB na súbor, max 10 súborov).</div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger mt-3 mb-0">@error</div>
            }

            @if (uploadedFiles.Count > 0)
            {
                <table class="table table-sm mt-3 mb-0">
                    <thead>
                        <tr>
                            <th>Súbor</th>
                            <th>Veľkosť</th>
                            <th>Typ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var file in uploadedFiles)
                        {
                            <tr>
                                <td>@file.FileName</td>
                                <td class="text-muted">@(file.Content.Length / 1024) KB</td>
                                <td>
                                    <select class="form-select form-select-sm" style="width: auto;"
                                            value="@file.Type"
                                            @onchange="e => file.Type = Enum.Parse<DocumentType>((string)e.Value!)">
                                        <option value="@DocumentType.ClaimReport">Hlásenie</option>
                                        <option value="@DocumentType.Invoice">Faktúra</option>
                                        <option value="@DocumentType.Photo">Fotodokumentácia</option>
                                    </select>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFile(file)">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3 d-flex justify-content-end">
                    <button class="btn btn-primary" @onclick="ProcessAsync" disabled="@isProcessing">
                        @(isProcessing ? "Spracúvam..." : "Spracovať")
                    </button>
                </div>
            }
        </div>
    </div>

    @if (isProcessing && !approvalPending)
    {
        <div class="alert alert-info">Agent analyzuje @uploadedFiles.Count dokument(y)...</div>
    }

    @if (approvalPending && pendingRequest is not null)
    {
        <div class="row g-3 mb-3">
            <div class="col-lg-6">
                <div class="card border-warning shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title text-warning">Vyžaduje sa schválenie</h5>

                        <table class="table table-sm table-borderless mb-2">
                            <tbody>
                                <tr><td class="text-muted">Zmluva</td><td><code>@pendingRequest.ContractNumber</code></td></tr>
                                <tr><td class="text-muted">Dátum udalosti</td><td>@(pendingRequest.IncidentDate?.ToString("d.M.yyyy") ?? "—")</td></tr>
                                <tr><td class="text-muted">Faktúry spolu</td><td>@pendingRequest.InvoiceTotal.ToString("N2") €</td></tr>
                                <tr><td class="text-muted">Spoluúčasť</td><td>− @pendingRequest.Deductible.ToString("N2") €</td></tr>
                                <tr><td class="text-muted">Limit zmluvy</td><td>@pendingRequest.Limit.ToString("N2") €</td></tr>
                                <tr><td class="fw-semibold">Navrhované plnenie</td><td class="fw-semibold">@pendingRequest.Payout.ToString("N2") €</td></tr>
                            </tbody>
                        </table>

                        @if (pendingRequest.HardBlocks.Count > 0)
                        {
                            <p class="fw-semibold mb-1 text-danger">Blokujúce problémy:</p>
                            <ul class="text-danger mb-3">
                                @foreach (var block in pendingRequest.HardBlocks)
                                {
                                    <li>@block</li>
                                }
                            </ul>
                        }

                        @if (pendingRequest.Exclusions.Count > 0)
                        {
                            <p class="fw-semibold mb-1 text-warning">Nájdené výluky z podmienok:</p>
                            @foreach (var ex in pendingRequest.Exclusions)
                            {
                                <div class="card border-warning mb-2">
                                    <div class="card-body py-2 px-3">
                                        <strong>[@ex.ParagraphNumber] @ex.ArticleTitle</strong>
                                        <p class="mb-1 small">@ex.Reasoning</p>
                                        <blockquote class="small text-muted mb-1 ps-2 border-start border-2">@ex.EvidenceFromClaim</blockquote>
                                        <p class="small mt-1 mb-0 fst-italic">@ex.Text</p>
                                    </div>
                                </div>
                            }
                        }

                        @if (pendingRequest.SoftSignals.Count > 0)
                        {
                            <p class="fw-semibold mb-1">Signály (@pendingRequest.SoftSignals.Count):</p>
                            <ul class="text-warning mb-3">
                                @foreach (var signal in pendingRequest.SoftSignals)
                                {
                                    <li>@signal</li>
                                }
                            </ul>
                        }

                        @{
                            var photos = uploadedFiles.Where(f => f.Type == DocumentType.Photo).ToList();
                        }
                        @if (photos.Count > 0)
                        {
                            <p class="fw-semibold mb-2 mt-3">Fotodokumentácia (@photos.Count):</p>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var photo in photos)
                                {
                                    var mime = Path.GetExtension(photo.FileName).ToLowerInvariant() == ".png" ? "image/png" : "image/jpeg";
                                    var dataUri = $"data:{mime};base64,{Convert.ToBase64String(photo.Content)}";
                                    var capturedUri = dataUri;
                                    var capturedName = photo.FileName;
                                    <img src="@dataUri" alt="@photo.FileName" title="@photo.FileName"
                                         @onclick="() => OpenPhotoPreview(capturedUri, capturedName)"
                                         style="width: 100px; height: 75px; object-fit: cover; border-radius: 6px; border: 1px solid #dee2e6; cursor: pointer;"
                                         class="shadow-sm" />
                                }
                            </div>
                        }

                        <div class="mt-3">
                            <button class="btn btn-success me-2" @onclick="() => Resolve(true)">Schváliť</button>
                            <button class="btn btn-outline-danger" @onclick="() => Resolve(false)">Zamietnuť</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="tool-info-row mb-3">
                            <h6 class="fw-semibold mb-0">Konzultácia s agentom</h6>
                            <span class="tool-info" tabindex="0" role="button"
                                  aria-label="Zobraziť nástroje, ktoré má agent k dispozícii">i</span>
                            <div class="tool-info-panel" role="tooltip">
                                <div class="tool-info-head">Nástroje, ktoré má agent k dispozícii</div>
                                <dl>
                                    <dt>GetPolicyDetail</dt>
                                    <dd>Detail zmluvy — platnosť, stav, rozsah krytia, spoluúčasť, limit a vozidlá.</dd>

                                    <dt>GetClaimsHistory</dt>
                                    <dd>Nároky na zmluve za zadaný počet mesiacov: dátum, typ škody, suma, stav.</dd>

                                    <dt>GetClaimDetail</dt>
                                    <dd>Detail jedného nároku — čo sa opravovalo, servis, faktúra, plnenie.</dd>

                                    <dt>FindClaimsByVehicle</dt>
                                    <dd>Nároky na ŠPZ naprieč všetkými zmluvami — zachytí zmenu majiteľa.</dd>

                                    <dt>SearchPolicyConditions</dt>
                                    <dd>Vyhľadá ustanovenia v poistných podmienkach — krytie, povinnosti, výluky.</dd>
                                </dl>
                                <div class="tool-info-foot">
                                    Všetky sú len na čítanie. Agent nevie nárok schváliť, zamietnuť ani zmeniť —
                                    rozhoduje výhradne likvidátor.
                                </div>
                            </div>
                        </div>

                        <div id="chat-scroll" class="flex-grow-1" style="min-height: 300px; max-height: 500px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.375rem; padding: 0.75rem; background: #fafafa;">
                            @if (chatMessages.Count == 0 && !isChatProcessing)
                            {
                                <p class="text-muted small mb-0 fst-italic">Opýtajte sa agenta na detaily nároku, poistné podmienky alebo históriu zmluvy.</p>
                            }
                            @foreach (var msg in chatMessages)
                            {
                                <div class="mb-2 d-flex @(msg.IsUser ? "justify-content-end" : "justify-content-start")">
                                    <div class="px-3 py-2 rounded-3 @(msg.IsUser ? "bg-primary text-white" : "bg-white border")"
                                         style="max-width: 85%;">
                                        <span style="white-space: pre-wrap;">@msg.Text</span>
                                        @if (msg.ToolsUsed.Count > 0)
                                        {
                                            <div class="mt-1">
                                                @foreach (var tool in msg.ToolsUsed)
                                                {
                                                    <span class="badge bg-secondary bg-opacity-25 text-dark me-1" style="font-size: 0.65rem;">@tool</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (isChatProcessing)
                            {
                                <div class="mb-2 d-flex justify-content-start">
                                    <div class="px-3 py-2 rounded-3 bg-white border">
                                        <em class="text-muted">Agent píše...</em>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <input type="text" class="form-control" @bind="chatInput" @bind:event="oninput"
                                   @onkeydown="ChatKeyDownAsync" placeholder="Opýtajte sa agenta..."
                                   disabled="@isChatProcessing" />
                            <button class="btn btn-outline-primary flex-shrink-0" @onclick="SendChatAsync"
                                    disabled="@(isChatProcessing || string.IsNullOrWhiteSpace(chatInput))">
                                Odoslať
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (analysisResult is not null)
    {
        var d = analysisResult.Decision;
        var borderClass = analysisResult.Outcome switch
        {
            ClaimOutcome.AutoApproved or ClaimOutcome.Approved => "border-success",
            ClaimOutcome.Rejected => "border-danger",
            ClaimOutcome.Escalated or ClaimOutcome.RequiresApproval => "border-warning",
            _ => ""
        };
        var titleClass = analysisResult.Outcome switch
        {
            ClaimOutcome.AutoApproved or ClaimOutcome.Approved => "text-success",
            ClaimOutcome.Rejected => "text-danger",
            ClaimOutcome.Escalated or ClaimOutcome.RequiresApproval => "text-warning",
            _ => ""
        };
        var title = analysisResult.Outcome switch
        {
            ClaimOutcome.AutoApproved => "Nárok automaticky schválený",
            ClaimOutcome.Approved => "Nárok schválený",
            ClaimOutcome.Rejected => "Nárok zamietnutý",
            ClaimOutcome.Escalated => "Nárok eskalovaný",
            _ => "Výsledok"
        };

        <div class="card shadow-sm @borderClass">
            <div class="card-body">
                <h5 class="card-title @titleClass">@title</h5>

                @if (analysisResult.EscalationCaseId is not null)
                {
                    <p class="text-muted small">Eskalačný spis: <code>@analysisResult.EscalationCaseId</code></p>
                }
                @if (analysisResult.ClaimId is not null)
                {
                    <p class="text-muted small">Nárok: <code>@analysisResult.ClaimId</code></p>
                }

                @if (d.Payout > 0 || d.InvoiceTotal > 0)
                {
                    <table class="table table-sm table-borderless mb-2" style="max-width: 360px;">
                        <tbody>
                            <tr><td class="text-muted">Faktúry spolu</td><td>@d.InvoiceTotal.ToString("N2") €</td></tr>
                            <tr><td class="text-muted">Spoluúčasť</td><td>− @d.Deductible.ToString("N2") €</td></tr>
                            <tr><td class="text-muted">Limit zmluvy</td><td>@d.Limit.ToString("N2") €</td></tr>
                            <tr><td class="fw-semibold">Navrhované plnenie</td><td class="fw-semibold">@d.Payout.ToString("N2") €</td></tr>
                        </tbody>
                    </table>
                }

                @if (d.HardBlocks.Count > 0)
                {
                    <p class="fw-semibold mb-1 text-danger">Blokujúce problémy:</p>
                    <ul class="text-danger">
                        @foreach (var block in d.HardBlocks)
                        {
                            <li>@block</li>
                        }
                    </ul>
                }
                @if (d.Exclusions.Count > 0)
                {
                    <p class="fw-semibold mb-1 text-warning">Nájdené výluky z podmienok:</p>
                    @foreach (var ex in d.Exclusions)
                    {
                        <div class="card border-warning mb-2">
                            <div class="card-body py-2 px-3">
                                <strong>[@ex.ParagraphNumber] @ex.ArticleTitle</strong>
                                <p class="mb-1 small">@ex.Reasoning</p>
                                <blockquote class="small text-muted mb-1 ps-2 border-start border-2">@ex.EvidenceFromClaim</blockquote>
                                <p class="small mt-1 mb-0 fst-italic">@ex.Text</p>
                            </div>
                        </div>
                    }
                }
                @if (d.SoftSignals.Count > 0)
                {
                    <p class="fw-semibold mb-1 text-warning">Signály na preverenie:</p>
                    <ul class="text-warning">
                        @foreach (var signal in d.SoftSignals)
                        {
                            <li>@signal</li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrEmpty(analysisResult.Summary))
                {
                    <hr />
                    <pre class="mb-0" style="white-space: pre-wrap;">@analysisResult.Summary</pre>
                }

                <div class="mt-3">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadSummaryAsync">
                        Stiahnuť zhrnutie (.md)
                    </button>
                </div>
            </div>
        </div>
    }

    @if (previewPhotoUri is not null)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1" @onclick="ClosePhotoPreview">
            <div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation>
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h6 class="modal-title mb-0">@previewPhotoName</h6>
                        <button type="button" class="btn-close" @onclick="ClosePhotoPreview"></button>
                    </div>
                    <div class="modal-body text-center p-2">
                        <img src="@previewPhotoUri" alt="@previewPhotoName"
                             style="max-width: 100%; max-height: 75vh; object-fit: contain;" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>
